<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kreativekoala.app-outreach</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/kreativekoala-outreach-harness/repo/harness/app-outreach/qualify_cycle.sh</string>
  </array>
  <!-- Daily run at 09:13, staggered off the other two mini harnesses' :47 runs.
       The pipeline has switched from discovery to qualification: we already have
       95,642 leads with emails and no dossier. The only work is fetching each
       lead's homepage + one LLM call per lead. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>13</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.kreativekoala-outreach/logs/launchagent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.kreativekoala-outreach/logs/launchagent.log</string>
</dict>
</plist>
