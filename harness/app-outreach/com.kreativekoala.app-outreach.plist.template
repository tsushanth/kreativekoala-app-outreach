<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kreativekoala.app-outreach</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/kreativekoala-outreach-harness/repo/harness/app-outreach/run_cycle.sh</string>
  </array>
  <!-- Was a 30-min StartInterval burst, to spend a large soon-expiring Claude quota
       window across all 7 apps. That window is spent: the CLI reports "You've hit
       your limit", so a 30-min cadence now buys ~48 failed runs/day of log noise.
       Retired to once/day on 2026-09-25, matching the other two mini harnesses.
       Staggered off the hour so it does not collide with their :47 runs. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>13</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.kreativekoala-outreach/logs/launchagent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.kreativekoala-outreach/logs/launchagent.log</string>
</dict>
</plist>
