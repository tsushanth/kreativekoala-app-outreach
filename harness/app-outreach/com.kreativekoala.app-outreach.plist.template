<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kreativekoala.app-outreach</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/kreativekoala-outreach-harness/repo/harness/app-outreach/run_cycle.sh</string>
  </array>
  <!-- Burst window: fires hourly so the ~15h of spare quota actually gets spent
       today across all 7 apps. Once the burst window is over, change this to
       StartCalendarInterval (once/day, like the other two mini harnesses) --
       see README.md "After the burst window". -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.kreativekoala-outreach/logs/launchagent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.kreativekoala-outreach/logs/launchagent.log</string>
</dict>
</plist>
